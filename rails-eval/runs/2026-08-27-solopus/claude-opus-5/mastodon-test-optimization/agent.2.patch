index 0000000000..521c4e0dc2
--- /dev/null
+++ b/spec/support/data_reuse.rb
@@ -0,0 +1,10 @@
+# frozen_string_literal: true
+
+# `before_all` (from test-prof) runs its block once for the whole example group,
+# inside a transaction that is rolled back when the group is over, instead of
+# once per example. It is meant for the (usually large) groups that share the
+# very same read-only setup: examples still run in their own nested transaction,
+# so anything they change is rolled back as usual.
+#
+# See docs/TESTING_PERFORMANCE.md before reaching for it.
+require 'test_prof/recipes/rspec/before_all'
diff --git a/spec/support/webhooks.rb b/spec/support/webhooks.rb
new file mode 100644
index 0000000000..b401960181
--- /dev/null
+++ b/spec/support/webhooks.rb
@@ -0,0 +1,24 @@
+# frozen_string_literal: true
+
+# Creating a user, an account, a status or a report enqueues `TriggerWebhookWorker`
+# from an `after_commit` callback, and Sidekiq runs inline in the test suite.
+#
+# The worker reloads the record and `WebhookService` then builds the JSON payload
+# of the event -- a full REST serialization of the record and its associations --
+# *before* looking up the webhooks it has to be delivered to. Virtually no spec
+# registers a webhook, so nearly every record we fabricate used to pay for a
+# serialization whose result was thrown away right after (~16% of the
+# `spec/requests` runtime, and a large chunk of `spec/models` as well).
+#
+# Bailing out when the instance has no webhook at all is behavior preserving:
+# `WebhookService#webhooks_for_event` would return an empty list and no
+# `Webhooks::DeliveryWorker` would be enqueued. Specs registering a webhook (see
+# `spec/services/webhook_service_spec.rb` or `spec/models/webhook_spec.rb`) still
+# exercise the whole code path.
+module TriggerWebhookWorkerSkipWithoutWebhooks
+  def perform(...)
+    super if Webhook.exists?
+  end
+end
+
+TriggerWebhookWorker.prepend(TriggerWebhookWorkerSkipWithoutWebhooks)

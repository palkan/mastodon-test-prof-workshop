@@ -1,5 +1,11 @@
 # frozen_string_literal: true
 
+# Enable YJIT (when available) to speed up the test suite. It's enabled here,
+# after the boot sequence, so we don't waste time compiling one-off boot code.
+# Set `DISABLE_YJIT=1` to opt out.
+yjit_available = defined?(RubyVM::YJIT) && RubyVM::YJIT.respond_to?(:enable) && !RubyVM::YJIT.enabled?

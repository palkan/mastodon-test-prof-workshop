diff --git a/spec/support/password_digests.rb b/spec/support/password_digests.rb
new file mode 100644
index 0000000000..ad5944c41d
--- /dev/null
+++ b/spec/support/password_digests.rb
@@ -0,0 +1,17 @@
+# frozen_string_literal: true
+
+# Hashing passwords with bcrypt is intentionally slow, and the test suite
+# creates a lot of users (all of them sharing the same handful of passwords).
+#
+# Devise already uses the minimum number of stretches in the test environment,
+# so the only remaining optimization is to avoid computing the same digest over
+# and over again: the memoized digest is a regular bcrypt digest, so password
+# verification keeps working exactly the same way.
+module PasswordDigestCache
+  def digest(klass, password)
+    cache = (Thread.current[:password_digest_cache] ||= {})
+    cache[[klass.pepper, klass.stretches, password]] ||= super
+  end
+end
+
+Devise::Encryptor.singleton_class.prepend(PasswordDigestCache)

diff --git a/spec/support/password_digests.rb b/spec/support/password_digests.rb
new file mode 100644
index 0000000000..ad5944c41d
--- /dev/null
+++ b/spec/support/password_digests.rb
@@ -0,0 +1,17 @@
+# frozen_string_literal: true
+
+# Hashing passwords with bcrypt is intentionally slow, and the test suite
+# creates a lot of users (all of them sharing the same handful of passwords).
+#
+# Devise already uses the minimum number of stretches in the test environment,
+# so the only remaining optimization is to avoid computing the same digest over
+# and over again: the memoized digest is a regular bcrypt digest, so password
+# verification keeps working exactly the same way.
+module PasswordDigestCache
+  def digest(klass, password)
+    cache = (Thread.current[:password_digest_cache] ||= {})
+    cache[[klass.pepper, klass.stretches, password]] ||= super
+  end
+end
+
+Devise::Encryptor.singleton_class.prepend(PasswordDigestCache)
diff --git a/spec/support/premailer.rb b/spec/support/premailer.rb
new file mode 100644
index 0000000000..0efd5e3a51
--- /dev/null
+++ b/spec/support/premailer.rb
@@ -0,0 +1,37 @@
+# frozen_string_literal: true
+
+# `premailer-rails` registers a delivery interceptor that inlines the mailer CSS
+# into every outgoing email. Doing so re-parses the whole mailer stylesheet and
+# then runs a Nokogiri query for each of its rules against the rendered HTML,
+# which costs ~20 ms per email -- about two thirds of the cost of delivering one.
+#
+# Sidekiq runs inline in the test suite, so every email a spec (indirectly)
+# triggers gets rendered *and* delivered while the example runs: that was ~5 s of
+# `spec/requests` and ~1.5 s of `spec/models` spent inlining CSS nobody looks at,
+# since those specs only care about the fact that an email was sent (and, at
+# most, about its subject or recipient).
+#
+# The interceptor is therefore only enabled where the resulting HTML is actually
+# under test: mailer specs, and any example tagged `:premailer`.
+module PremailerHelpers
+  def self.enabled
+    ActionMailer::Base.register_interceptor(Premailer::Rails::Hook)
+    yield
+  ensure
+    ActionMailer::Base.unregister_interceptor(Premailer::Rails::Hook)
+  end
+end
+
+RSpec.configure do |config|
+  config.before(:suite) do
+    ActionMailer::Base.unregister_interceptor(Premailer::Rails::Hook)
+  end
+
+  config.around(:each, type: :mailer) do |example|
+    PremailerHelpers.enabled { example.run }
+  end
+
+  config.around(:each, :premailer) do |example|
+    PremailerHelpers.enabled { example.run }
+  end
+end
diff --git a/spec/support/profiling.rb b/spec/support/profiling.rb
new file mode 100644
index 0000000000..b82aa29c6a
--- /dev/null
+++ b/spec/support/profiling.rb
@@ -0,0 +1,57 @@
+# frozen_string_literal: true
+
+# Opt-in profiling helpers (see docs/TESTING_PERFORMANCE.md).
+#
+# Enable with `PROFILE=1` and pick a profiler through TestProf's env vars, e.g.:
+#
+#   PROFILE=1 EVENT_PROF=sql.active_record bundle exec rspec spec/models
+#   PROFILE=1 RD_PROF=1 bundle exec rspec spec/models
+#   PROFILE=1 FPROF=1 bundle exec rspec spec/models
+#   PROFILE=1 TEST_STACK_PROF=1 bundle exec rspec spec/models
+require 'test-prof' if ENV['PROFILE']
+
+# Sidekiq runs inline in the test suite, so a chunk of the runtime is spent in
+# workers (and in the mailers they deliver) that no example is looking at.
+# `WORKER_PROF=1` reports how many times each worker/mailer ran and how long it
+# took, which is how the wasteful ones get spotted.
+if ENV['WORKER_PROF']
+  module WorkerProfiling
+    STATS = Hash.new { |hash, key| hash[key] = [0, 0.0] }
+
+    def self.record(key, duration)
+      stats = STATS[key]
+      stats[0] += 1
+      stats[1] += duration
+    end
+
+    def self.report
+      warn row('WORKER', 'COUNT', 'TIME')
+      STATS
+        .sort_by { |_, (_, time)| -time }
+        .first(40)
+        .each { |key, (count, time)| warn row(key, count, time.round(3)) }
+    end
+
+    def self.row(key, count, time)
+      "#{key.to_s.ljust(60)}#{count.to_s.rjust(10)}#{time.to_s.rjust(10)}"
+    end
+
+    module JobTracking
+      def process_job(job_hash)
+        started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
+        super
+      ensure
+        key = name == 'Sidekiq::ActiveJob::Wrapper' ? "ActiveJob(#{job_hash['wrapped']})" : name
+        WorkerProfiling.record(key, Process.clock_gettime(Process::CLOCK_MONOTONIC) - started_at)
+      end
+    end
+  end
+
+  Sidekiq::Job::ClassMethods.prepend(WorkerProfiling::JobTracking)
+
+  ActiveSupport::Notifications.subscribe('process.action_mailer') do |_name, start, finish, _id, payload|
+    WorkerProfiling.record("render #{payload[:mailer]}##{payload[:action]}", finish - start)
+  end
+
+  at_exit { WorkerProfiling.report }
+end
diff --git a/spec/support/webhooks.rb b/spec/support/webhooks.rb
new file mode 100644
index 0000000000..b401960181
--- /dev/null
+++ b/spec/support/webhooks.rb
@@ -0,0 +1,24 @@
+# frozen_string_literal: true
+
+# Creating a user, an account, a status or a report enqueues `TriggerWebhookWorker`
+# from an `after_commit` callback, and Sidekiq runs inline in the test suite.
+#
+# The worker reloads the record and `WebhookService` then builds the JSON payload
+# of the event -- a full REST serialization of the record and its associations --
+# *before* looking up the webhooks it has to be delivered to. Virtually no spec
+# registers a webhook, so nearly every record we fabricate used to pay for a
+# serialization whose result was thrown away right after (~16% of the
+# `spec/requests` runtime, and a large chunk of `spec/models` as well).
+#
+# Bailing out when the instance has no webhook at all is behavior preserving:
+# `WebhookService#webhooks_for_event` would return an empty list and no
+# `Webhooks::DeliveryWorker` would be enqueued. Specs registering a webhook (see
+# `spec/services/webhook_service_spec.rb` or `spec/models/webhook_spec.rb`) still
+# exercise the whole code path.
+module TriggerWebhookWorkerSkipWithoutWebhooks
+  def perform(...)
+    super if Webhook.exists?
+  end
+end
+
+TriggerWebhookWorker.prepend(TriggerWebhookWorkerSkipWithoutWebhooks)
